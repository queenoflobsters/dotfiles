# gitignore config fuckery
!.config
.config/*

# Helix editor 
!.config/helix
!.config/helix/*
.config/helix/themes/noctalia.toml
.config/helix/runtime

# Mitos editor
!.config/mitos
!.config/mitos/*
.config/mitos/themes/noctalia.toml
.config/mitos/runtime

# Clangd Compiler
!.config/clangd
!.config/clangd/*

# Ghostty Terminal
!.config/ghostty
!.config/ghostty/*
.config/ghostty/themes/noctalia

# Hyprland Window Manager
!.config/hypr
!.config/hypr/*
.config/hypr/noctalia.lua

# Noctalia shell
!.config/noctalia
!.config/noctalia/*

# XKB Layouts (for altgr-weur)
!.config/xkb
!.config/xkb/*

# Remove nwg-displays auto generated config
.config/hypr/monitors.conf
.config/hypr/monitors.lua

# The friendly interactive shell
!.config/fish
!.config/fish/config.fish
!.config/fish/functions
!.config/fish/functions/*

# Starship, custom command prompt
!.config/starship.toml

# Foot terminal
!.config/foot
!.config/foot/*
.config/foot/themes

# Mullrun configuration
!.config/mullrun
!.config/mullrun/*
